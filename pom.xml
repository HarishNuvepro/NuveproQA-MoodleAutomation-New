<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.nuvepro.moodle</groupId>
    <artifactId>moodle-ui-automation</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>
    <name>Nuvepro Moodle UI Automation (Playwright + TestNG)</name>

    <properties>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <playwright.version>1.48.0</playwright.version>
        <testng.version>7.10.2</testng.version>
        <cucumber.version>7.18.1</cucumber.version>
        <!-- default suite; override with a profile -->
        <suiteXmlFile>testng-fast.xml</suiteXmlFile>
        <!-- Cucumber scenario filter: fast = non-destructive; slow profile flips to provisioning -->
        <cucumber.tags>not @provisioning and not @skip and not @deviation and not @sandbox-cleanup and not @module-cleanup and not @assessment-cleanup</cucumber.tags>
        <!-- Browser defaults; -Pwatch sets headed. Default slowmo 650ms so actions are visible when headed. -->
        <headless>true</headless>
        <slowmo>650</slowmo>
        <sandbox.parallel>false</sandbox.parallel>
        <parallel.browsers>5</parallel.browsers>
        <!-- Set via CLI (-Dcucumber.features=...); empty = all runners use @CucumberOptions paths -->
        <cucumber.features></cucumber.features>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.microsoft.playwright</groupId>
            <artifactId>playwright</artifactId>
            <version>${playwright.version}</version>
        </dependency>
        <dependency>
            <groupId>org.testng</groupId>
            <artifactId>testng</artifactId>
            <version>${testng.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.cdimascio</groupId>
            <artifactId>dotenv-java</artifactId>
            <version>3.0.2</version>
        </dependency>
        <!-- BDD layer (optional): Gherkin .feature files + step definitions -->
        <dependency>
            <groupId>io.cucumber</groupId>
            <artifactId>cucumber-java</artifactId>
            <version>${cucumber.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.cucumber</groupId>
            <artifactId>cucumber-testng</artifactId>
            <version>${cucumber.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.cucumber</groupId>
            <artifactId>cucumber-picocontainer</artifactId>
            <version>${cucumber.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <id>require-jdk17</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>[17,)</version>
                                    <message>JDK 17+ is required. Run via .\mvnw.cmd (auto-selects an installed JDK 17+) or set JAVA_HOME to a JDK 17+ install.</message>
                                </requireJavaVersion>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
                <configuration>
                    <suiteXmlFiles>
                        <suiteXmlFile>${suiteXmlFile}</suiteXmlFile>
                    </suiteXmlFiles>
                    <systemPropertyVariables>
                        <cucumber.filter.tags>${cucumber.tags}</cucumber.filter.tags>
                        <cucumber.features>${cucumber.features}</cucumber.features>
                        <headless>${headless}</headless>
                        <slowmo>${slowmo}</slowmo>
                        <sandbox.parallel>${sandbox.parallel}</sandbox.parallel>
                        <parallel.browsers>${parallel.browsers}</parallel.browsers>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- mvn test -Pslow  -> runs the provisioning (real cloud lab) suite -->
        <profile>
            <id>slow</id>
            <properties>
                <suiteXmlFile>testng-slow.xml</suiteXmlFile>
                <cucumber.tags>@provisioning</cucumber.tags>
            </properties>
        </profile>
        <!-- mvn test -Pwatch -Dcucumber.tags="@PG-1" -> runs ONLY the tagged scenario(s),
             no ConnectivityTest. Watch profile is headed + slowed so you can follow the UI.
             Override: -Dheadless=true -Dslowmo=0 -->
        <profile>
            <id>watch</id>
            <properties>
                <suiteXmlFile>testng-watch.xml</suiteXmlFile>
                <headless>false</headless>
                <slowmo>800</slowmo>
            </properties>
        </profile>
        <!-- Auto-activates when -Dcucumber.features=... is set. Runs ONLY RunCucumberTest so parallel
             sandbox runners do not pick up the filtered feature (Playwright pipe-closed failures). -->
        <profile>
            <id>single-feature</id>
            <activation>
                <property>
                    <name>cucumber.features</name>
                </property>
            </activation>
            <properties>
                <suiteXmlFile>testng-watch.xml</suiteXmlFile>
            </properties>
        </profile>
        <!-- Complete Sandbox suite with five capped Chromium workers.
             Sandbox student scenarios remain in one lane; independent Manage Labs scenarios
             run concurrently. The four deletes are fired together under the same five-browser cap. -->
        <profile>
            <id>cleanup</id>
            <properties>
                <cucumber.tags>@module-cleanup</cucumber.tags>
            </properties>
        </profile>
        <profile>
            <id>sandbox-parallel</id>
            <properties>
                <suiteXmlFile>testng-sandbox-parallel.xml</suiteXmlFile>
                <cucumber.features>src/test/resources/features/sandbox.feature</cucumber.features>
                <cucumber.tags>not @skip and not @sandbox-cleanup and not @module-cleanup</cucumber.tags>
                <headless>true</headless>
                <slowmo>0</slowmo>
                <sandbox.parallel>true</sandbox.parallel>
                <parallel.browsers>5</parallel.browsers>
            </properties>
        </profile>
        <!-- 8 concurrent scenarios, one browser each. Declared LAST so its suiteXmlFile wins over
             single-feature (auto-activated by -Dcucumber.features). Headed: add -Dheadless=false. -->
        <profile>
            <id>parallel</id>
            <properties>
                <suiteXmlFile>testng-parallel.xml</suiteXmlFile>
                <headless>true</headless>
                <slowmo>0</slowmo>
                <sandbox.parallel>true</sandbox.parallel>
                <parallel.browsers>8</parallel.browsers>
            </properties>
        </profile>
        <!-- Difficulty module: one scenario at a time (shared Cloud Server admin config). Do NOT use testng-parallel5.xml here. -->
        <profile>
            <id>dlc-serial</id>
            <properties>
                <suiteXmlFile>testng-dlc-serial.xml</suiteXmlFile>
                <cucumber.features>src/test/resources/features/difficulty_level_configuration.feature</cucumber.features>
                <cucumber.tags>@dlc</cucumber.tags>
                <headless>true</headless>
                <slowmo>0</slowmo>
                <sandbox.parallel>true</sandbox.parallel>
                <parallel.browsers>1</parallel.browsers>
            </properties>
        </profile>
    </profiles>
</project>
