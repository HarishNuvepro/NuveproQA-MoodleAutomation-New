<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- Parallel suite: 8 concurrent Cucumber scenarios, each with its own browser.
     Usage: .\mvnw.cmd test -Pparallel "-Dcucumber.features=src/test/resources/features/upload_users.feature" -->
<suite name="MoodleParallelSuite" verbose="1" data-provider-thread-count="8">
    <test name="Parallel">
        <classes>
            <class name="com.nuvepro.moodle.RunParallelTest"/>
        </classes>
    </test>
</suite>
